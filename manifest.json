{
  "manifest_version": 3,
  "name": "Fil d'actu — Widget",
  "version": "1.0.1",
  "description": "Widget d'actualités (Reuters, AP, AFP, BBC, France 24) construit par analyse des pages, sans RSS.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fil d'actualité",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.reuters.com/*",
    "https://apnews.com/*",
    "https://factuel.afp.com/*",
    "https://www.bbc.com/*",
    "https://www.france24.com/*"
  ]
}
